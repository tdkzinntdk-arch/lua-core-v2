local function GetBestQuest()
	local bestLevelReq = -1
	local bestRnq, bestTaskName, bestRidq = nil, nil, nil
	for rnq, v in QuestController.CachedQuestData do
		if table.find({ "BartiloQuest", "Trainees", "MarineQuest", "CitizenQuest", }, tostring(rnq)) then
			continue
		end
        if type(v) ~= "table" then
            continue
        end
		for ridq, ct in pairs(v) do
            if type(ct) ~= "table" or type(ct.LevelReq) ~= "number"
                or type(ct.Task) ~= "table" or ct.LevelReq < 0
                or LocalPlayer.Data.Level.Value < ct.LevelReq then
				continue
			end
			for O, taskValue in pairs(ct.Task) do
				if type(taskValue) == "number" and taskValue > 1
                and ct.LevelReq > bestLevelReq then
					bestLevelReq = ct.LevelReq
					bestRnq = rnq
					bestTaskName = tostring(O)
					bestRidq = ridq
				end
			end
		end
	end
	if not bestRnq then
		return
	end
	return bestLevelReq, bestRnq, bestTaskName, bestRidq
end

