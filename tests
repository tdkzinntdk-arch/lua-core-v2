-- ADICIONADO (Zyon): helper de espera de personagem COM timeout.
--
-- Havia 6 loops `while not Character ...` sem nenhuma condicao de saida
-- (L458, L519, L586, L1111, L1437, L3247). Se o personagem ficasse nil
-- (kick, morte sem respawn, erro de rede), cada um desses travava a thread
-- PARA SEMPRE sem mensagem.
--
-- Este helper centraliza a espera: timeout configuravel, log do motivo, e
-- retorno booleano para o chamador decidir (em vez de travar em silencio).
-- `precisaRoot` cobre os casos que tambem exigem PrimaryPart.
local function EsperarPersonagem(timeout, precisaRoot)
	timeout = timeout or 30
	local t0 = tick()

	while true do
		local c = Character
		if c and c.Parent then
			local hum = c:FindFirstChildOfClass("Humanoid")
			local ok = hum ~= nil and hum.Health > 0
			if precisaRoot then
				ok = ok and c.PrimaryPart ~= nil
			end
			if ok then
				return true
			end
		end

		if (tick() - t0) >= timeout then
			warn(("[Zyon] personagem indisponivel apos %ds (morte/kick/respawn). Abortando a etapa."):format(timeout))
			return false
		end

		LogChange("tween_wait", "tween: waiting for character")
		task.wait(0.1)
	end
end

local function RunTween(v, high, requestedSpeed)
    if not EsperarPersonagem(30, true) then
        LogChange("tween_root", "tween: character unavailable")
        return
    end
    local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        LogChange("tween_root", "tween: root missing")
        return
    end
    if typeof(v) == "CFrame" then
        v = v.Position
    end
    Character.Humanoid.Sit = false
    local targetCFrame = typeof(v) == "Vector3" and CFrame.new(v) or v
    local pos = targetCFrame.Position + Vector3.new(0, high or 0, 0)
    local rot = rootPart.CFrame - rootPart.Position
    local finalCFrame = CFrame.new(pos) * rot
    local distance = (rootPart.Position - finalCFrame.Position).Magnitude
    local speed
    if type(requestedSpeed) == "number" and requestedSpeed > 0 and requestedSpeed < math.huge then
        speed = math.clamp(requestedSpeed, 25, 1000)
    elseif distance < 250 then
        speed = 285
    elseif distance < 500 then
        speed = 260
    elseif distance < 1000 then
        speed = 240
    else
        speed = 200
    end
    local travelTime = distance / speed
    if distance >= 1000 then
        LogChange("long_tween", "tween: long travel")
    end
    tw = TweenService:Create(rootPart, TweenInfo.new(travelTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), { CFrame = finalCFrame })
    TwDono = TwNovaGeracao()   -- CORRIGIDO (Zyon): registra a posse
    tw:Play()
    return tw
end
