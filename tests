    local ok, guideData = pcall(function()
        return require(ReplicatedStorage.GuideModule).Data.NPCList
    end)
    if not ok or type(guideData) ~= "table" then return nil end
    local nearest, nearestDist = nil, math.huge
    for entryKey, entry in pairs(guideData) do
        if type(entry) == "table" then
            local matches = tostring(entryKey):lower() == questName:lower()
            if not matches then
                for _, value in pairs(entry) do
                    if type(value) == "string" and value:lower() == questName:lower() then
                        matches = true
                        break
                    end
                end
            end
            if matches then
