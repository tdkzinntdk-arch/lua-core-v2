-- Raid: nunca oferecer fruta com valor igual ou superior a 1.000.000 Beli.
local RAID_FRUIT_PRICE_LIMIT = 1000000

local function GetUseableFruit()
    local ok, data = pcall(function() return IRS:GetItems(KEYS.QUANTITY) end)
    if not ok or type(data) ~= "table" then
        warn("[Zyon] Raid: nao foi possivel ler o inventario de frutas")
        return nil
    end

    local cheapestKey, cheapestPrice = nil, RAID_FRUIT_PRICE_LIMIT
    for _, record in data do
        local itemOk, item = pcall(function() return MATCH(record.ItemId)._ok end)
        if itemOk and type(item) == "table" and item.Display and item.Quality and item.Index
            and item.Display.Category == "Blox Fruit" then
            local price = tonumber(item.Quality.MoneyPrice)
            local quantity = tonumber(record.Value) or 0
            local storageKey = item.Index.StorageKey
            if price and price > 0 and price < RAID_FRUIT_PRICE_LIMIT
                and quantity > 0 and type(storageKey) == "string" and storageKey ~= ""
                and price < cheapestPrice then
                cheapestKey, cheapestPrice = storageKey, price
            end
        end
    end
    return cheapestKey
end

-- Frutas fisicas na mochila/personagem podem ser gastas pelo NPC da raid.
