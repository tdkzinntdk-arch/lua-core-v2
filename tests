    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not root.Parent then return math.huge end
    return (root.Position - position).Magnitude
end

local function ApproachQuestNpc(position, questName)
    -- Primeiro usa a rota normal (incluindo as entradas/atalhos por Sea).
    -- O resultado booleano do tween NAO substitui a distancia real.
    local travelOk = TweenWithRespawnRetry(position, 350)
    task.wait(0.35)
    local remaining = QuestNpcDistance(position)
    if remaining <= QUEST_NPC_RADIUS then return true end

    warn(string.format(
        "[Zyon] quest: initial travel %s but npc still %.1f studs away (%s); trying short segments",
        travelOk and "completed" or "failed/cancelled", remaining, tostring(questName)))
    LogChange("quest_retry", "quest: correcting route to " .. tostring(questName))
    SetStatus("quest | correcting route: " .. tostring(questName))

    -- Trechos curtos reduzem os efeitos de reposicionamento do personagem,
    -- sem forçar teleporte instantaneo e sem mudar o movimento da raid.
    local overallDeadline = tick() + 75
    local stalledLegs = 0
    for leg = 1, 12 do
        if tick() >= overallDeadline then break end
        if GetQuestData() then return true end
        local character, humanoid, root = WaitForAliveCharacter(8)
        if not character or not humanoid or not root then return false end
        local origin = root.Position
        remaining = (origin - position).Magnitude
        if remaining <= QUEST_NPC_RADIUS then return true end

        local stepDistance = math.min(500, remaining)
        local destination = origin + (position - origin).Unit * stepDistance
        local motion = RunTween(destination, nil, 250)
        if not motion then
            warn("[Zyon] quest: could not begin movement segment " .. leg)
            break
        end
        local segmentDeadline = math.min(overallDeadline, tick() + stepDistance / 250 + 4)
        local startDistance = remaining
        while tick() < segmentDeadline and QuestNpcDistance(position) > QUEST_NPC_RADIUS do
            if motion.PlaybackState == Enum.PlaybackState.Cancelled then break end
            if motion.PlaybackState == Enum.PlaybackState.Completed then break end
            if not character.Parent or humanoid.Health <= 0 then break end
            task.wait(0.15)
        end
        if motion.PlaybackState == Enum.PlaybackState.Playing then
            pcall(function() motion:Cancel() end)
        end
        task.wait(0.25) -- detecta correção/reversão de posição pelo servidor
        local afterDistance = QuestNpcDistance(position)
        LogChange("quest_segment", string.format("quest: segment %d, npc distance %.0f", leg, afterDistance))
        if afterDistance <= QUEST_NPC_RADIUS then return true end
        if afterDistance >= startDistance - 20 then
            stalledLegs = stalledLegs + 1
            warn(string.format("[Zyon] quest: segment %d made no progress (%.1f -> %.1f studs); tween=%s",
                leg, startDistance, afterDistance, tostring(motion.PlaybackState)))
            if stalledLegs >= 2 then break end
        else
            stalledLegs = 0
        end
    end
    warn(string.format("[Zyon] quest: could not reach npc=%s; remaining=%.1f; %s",
        tostring(questName), QuestNpcDistance(position), QuestStateDiagnostics()))
    return false
end

local function TakeQuest()
    if tick() < lastTakeQuest then return end
    local q = GetQuest()
    if q and q.NameQuest then
        LogChange("quest_target", "quest: " .. string.lower(tostring(q.NameQuest)) .. " / " .. string.lower(tostring(q.NameMonster or "unknown")))
    else
        LogChange("quest_target", "quest: no target")
    end
    if GetQuestData() then return end
    if not (q and q.NameQuest and q.ID) then
        lastTakeQuest = tick() + 3
        warn("[Zyon] quest: quest selection incomplete")
        return
    end

    local questPos = GetQuestPosition(q.NameQuest)
    LogChange("quest_travel", questPos and "quest: traveling to npc" or "quest: npc position missing")
    if not questPos then
        warn("[Zyon] Quest NPC location unavailable: " .. tostring(q.NameQuest))
        lastTakeQuest = tick() + 6
        return
    end
    SetStatus("quest | going to npc: " .. tostring(q.NameQuest))
    -- LOG explicito permite distinguir falha na posicao do GuideModule
    -- de falha na viagem e nao faz tentativas de StartQuest de 2km longe.
    local arrived = ApproachQuestNpc(questPos, q.NameQuest)
    if GetQuestData() then
        lastTakeQuest = tick() + 1
        return
    end
    local distance = QuestNpcDistance(questPos)
    if not arrived or distance > QUEST_NPC_RADIUS then
        warn(string.format("[Zyon] quest: unable to approach npc=%s; distance=%.1f; target=(%.0f,%.0f,%.0f)",
            tostring(q.NameQuest), distance, questPos.X, questPos.Y, questPos.Z))
        lastTakeQuest = tick() + 6
        return
    end

    LogChange("quest_start", "quest: starting " .. string.lower(tostring(q.NameQuest)))
    SetStatus("quest | starting " .. string.lower(tostring(q.NameQuest)))
    local ok, result = pcall(function()
        return CommF_:InvokeServer("StartQuest", q.NameQuest, q.ID)
    end)
    if not ok then
        warn("[Zyon] Quest StartQuest failed: " .. tostring(result))
    else
        -- A quest pode demorar um instante para sincronizar QuestUpdate.
        local deadline = tick() + 3
        repeat task.wait(0.2) until GetQuestData() or tick() >= deadline
        if not GetQuestData() then
            warn(string.format("[Zyon] quest: StartQuest unconfirmed; npc=%s id=%s distance=%.1f result=%s; %s",
                tostring(q.NameQuest), tostring(q.ID), QuestNpcDistance(questPos), tostring(result), QuestStateDiagnostics()))
        end
    end
    lastTakeQuest = tick() + (GetQuestData() and 1 or 4)
end

