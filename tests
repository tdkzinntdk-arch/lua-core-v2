-- Com a quest ativa, use o nome informado pelo servidor, mesmo se os mobs
-- ainda nao estiverem carregados em workspace.Enemies (StreamingEnabled).
local function NormalizeQuestMobName(name)
    name = tostring(name or "")
    name = name:gsub("%s*%[[Ll]v%.?%s*%d+%]", "")
    name = name:gsub("%s*%[[Bb]oss%]", "")
    return name:match("^%s*(.-)%s*$"):lower()
end

