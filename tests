-- Mesma rotina de quests para Sea 1, Sea 2 e Sea 3; sem mobs fixos
-- para faixas de nivel (Shanda/God's Guard eram incorretos para lv 10-119).
local function FarmLevelLogic()
    local level = LocalPlayer.Data.Level.Value
    local questName = tostring(GetActiveQuestMobName() or "")
    if questName == "" then
        LogChange("farm_no_quest", "farm: unable to select a level quest at lv " .. level)
        SetStatus("farm | quest unavailable | lv " .. level)
        task.wait(1)
        return
    end

    -- On a fresh script start, QuestUpdate may not have been delivered yet.
    -- GuideModule.QuestData serves as a second authoritative client source.
    if not GetQuestData() then
        LogChange("farm_quest", "farm: acquiring quest for " .. questName)
        SetStatus("farm | taking quest | lv " .. level)
        TakeQuest()
        if not GetQuestData() then
            LogChange("farm_wait_reason", "farm: quest still inactive; " .. QuestStateDiagnostics())
            SetStatus("farm | waiting for quest | lv " .. level)
            task.wait(0.6)
            return
        end
    end

    local enemy = FindActiveQuestEnemy()
    if enemy then
        LogChange("farm_target", "farm: fighting " .. questName)
        SetStatus("farm | defeating " .. questName .. " | lv " .. level)
        local humanoid = enemy:FindFirstChildOfClass("Humanoid")
        local root = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
        local deadline = tick() + 55
        local nextMove, lastDistance, stalledSince = 0, math.huge, tick()
        while enemy.Parent == workspace.Enemies and humanoid and humanoid.Parent and humanoid.Health > 0
            and root and root.Parent and GetQuestData() and tick() < deadline do
            local dist = LocalPlayer:DistanceFromCharacter(root.Position)
            if dist + 12 < lastDistance then stalledSince = tick() end
            lastDistance = dist
            if dist > 32 then
                if tick() >= nextMove then
                    local newTween = Tween(root.Position + Vector3.new(0, 18, 5), 350)
                    if not newTween then break end
                    nextMove = tick() + math.clamp(dist / 350, 0.7, 3)
                end
                if tick() - stalledSince > 12 then
                    LogChange("farm_movement", "farm: stalled approaching " .. questName .. "; retrying")
                    StopTween()
                    break
                end
            else
                stalledSince = tick()
                -- Can attack only actual mobs in workspace.Enemies.
                BringMob(enemy.Name)
                EquipWeapon()
                Attack()
            end
            task.wait(0.18)
        end
        if enemy.Parent and humanoid and humanoid.Health > 0 and tick() >= deadline then
            warn("[Zyon] farm: timed out on " .. questName .. "; reassessing")
        end
        return
    end

    -- No mobs loaded: travel to spawn markers (even nested), then rotate
    -- between points to force streaming of nearby enemies.
    local waypoint, waypointCount = SelectQuestWaypoint()
    if not waypoint then
        LogChange("farm_no_spawn", "farm: no location for " .. questName)
        SetStatus("farm | spawn missing: " .. questName)
        warn("[Zyon] farm: no marker, template or quest NPC for " .. questName)
        task.wait(2)
        return
    end
    local destination = waypoint.Position + Vector3.new(0, 20, 0)
    local distance = LocalPlayer:DistanceFromCharacter(destination)
    if distance > 42 then
        LogChange("farm_target", "farm: going to " .. questName .. " spawn (" .. waypoint.Source .. ")")
        SetStatus("farm | going to quest mobs | lv " .. level)
        local journey = Tween(destination, 350)
        if not journey then
            warn("[Zyon] farm: unable to tween to " .. questName)
            task.wait(0.8)
            return
        end
        local deadline = math.min(FarmWaypointUntil, tick() + math.clamp(distance / 200 + 4, 7, 35))
        while tick() < deadline and GetQuestData()
            and LocalPlayer:DistanceFromCharacter(destination) > 42 do
            if FindActiveQuestEnemy() then break end
            task.wait(0.3)
        end
    else
        LogChange("farm_target", "farm: scanning " .. questName .. " spawn " .. FarmWaypointIndex .. "/" .. waypointCount)
        SetStatus("farm | searching " .. questName .. " | lv " .. level)
        task.wait(1)
    end
end

