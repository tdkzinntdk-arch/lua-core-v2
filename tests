-- Nomes reais das ferramentas no inventario. As chaves internas usadas pelo
-- kaitun nao coincidem sempre com o nome exibido pelo jogo.
local MeleeToolNames = {
	BlackLeg = "Dark Step",
	Electro = "Electric",
	FishmanKarate = "Water Kung Fu",
	DragonClaw = "Dragon Breath",
	Superhuman = "Superhuman",
	DeathStep = "Death Step",
	SharkmanKarate = "Sharkman Karate",
	ElectricClaw = "Electric Claw",
	DragonTalon = "Dragon Talon",
	Godhuman = "Godhuman",
}
local function GetMeleeToolName(key)
	return MeleeToolNames[key] or key:gsub("(%l)(%u)", "%1 %2")
end
-- Um estilo com maestria zero pode JA estar comprado. O inventario de
-- maestrias informa posse separadamente do numero de niveis de maestria.
local MeleeOwned = {}
local lastMeleeDataCheck = 0
local function CheckMeleeMastery(force)
    local now = tick()
    if not force and CheckedMelee and (now - lastMeleeDataCheck) < 10 then
        return true
    end
    local success, data = pcall(function() return IRS:GetItems(KEYS.MASTERY) end)
    if not success or type(data) ~= "table" then
        LogChange("melee_data", "melee: unable to verify owned styles; avoiding risky purchases")
        return false
    end
    -- So substitui informacao quando a leitura inteira funciona.
    local owned = {}
    local levels = {}
    for _, record in data do
        local ok, matched = pcall(function() return MATCH(record.ItemId) end)
        local item = ok and matched and matched._ok
        if item and item.Index and item.Display and item.Display.Category == "Fighting Style" then
            local storageKey = item.Index.StorageKey
            if type(storageKey) == "string" then
                local key = Name2Name[storageKey] or storageKey:gsub(" ", "")
                if MeleeData[key] ~= nil then
                    owned[key] = true -- inclusive com record.Value == 0
                    levels[key] = tonumber(record.Value) or 0
                end
            end
        end
    end
    for key, value in levels do MeleeData[key] = value end
    for key in owned do MeleeOwned[key] = true end
    CheckedMelee = true
    lastMeleeDataCheck = now
    LogChange("melee_data", "melee: ownership and mastery verified")
    return true
end

local function OwnsMeleeStyle(key)
    if MeleeOwned[key] or (MeleeData[key] or 0) > 0 then return true end
    local displayName = GetMeleeToolName(key)
    if HasItem(displayName) then return true end
    -- Nome antigo do Dragon Breath aparece em alguns clientes/codigos.
    if key == "DragonClaw" and HasItem("Dragon Claw") then return true end
    return false
end

