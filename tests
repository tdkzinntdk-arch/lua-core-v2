-- Determina locais de spawn nos 3 Seas a partir dos marcadores reais do jogo.
-- Somente NPCs em workspace.Enemies sao tratados como alvos vivos.
local function GetSpawnMarkerPosition(marker)
    if marker:IsA("Attachment") then
        return marker.WorldPosition
    elseif marker:IsA("BasePart") or marker:IsA("Model") then
        return marker:GetPivot().Position
    end
    return nil
end

local function GetQuestSpawnCandidates()
    local target = NormalizeQuestMobName(GetActiveQuestMobName())
    local candidates, signatures = {}, {}
    if target == "" then
        return candidates
    end
    local function add(position, source)
        if typeof(position) ~= "Vector3" then return end
        if position.Magnitude > 100000 then return end
        local key = string.format("%d:%d:%d", math.floor(position.X / 12), math.floor(position.Y / 12), math.floor(position.Z / 12))
        if signatures[key] then return end
        signatures[key] = true
        candidates[#candidates+1] = {Position = position, Source = source}
    end

    local origin = workspace:FindFirstChild("_WorldOrigin")
    local folders = {}
    local replicatedSpawns = ReplicatedStorage:FindFirstChild("FortBuilderReplicatedSpawnPositionsFolder")
    local worldSpawns = origin and origin:FindFirstChild("EnemySpawns")
    if replicatedSpawns then folders[#folders + 1] = replicatedSpawns end
    if worldSpawns then folders[#folders + 1] = worldSpawns end
    for _, folder in ipairs(folders) do
        if folder then
            -- GetDescendants also finds spawn markers nested inside folders.
            for _, marker in ipairs(folder:GetDescendants()) do
                if NormalizeQuestMobName(marker.Name) == target then
                    local ok, position = pcall(GetSpawnMarkerPosition, marker)
                    if ok then add(position, "marker") end
                end
            end
        end
    end

    -- Only use stored mob model as a navigation hint, never as a live enemy.
    -- Discard models at origin (0,0,0) and unrelated/out-of-region templates.
    if #candidates == 0 then
        local q = GetQuest()
        local questNpcPos = q and q.NameQuest and GetQuestPosition(q.NameQuest)
        for _, model in ipairs(ReplicatedStorage:GetChildren()) do
            if model:IsA("Model") and NormalizeQuestMobName(model.Name) == target then
                local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                if root and root.Position.Magnitude > 250
                    and (not questNpcPos or (root.Position - questNpcPos).Magnitude < 3000) then
                    add(root.Position, "template")
                end
            end
        end
    end

    -- Reference from existing CDK logic; this is not a universal map lookup.
    if #candidates == 0 and World.Sea3() and target == "mythological pirate" then
        local base = Vector3.new(-13239, 520, -6813)
        add(base, "cdk-reference")
        for _, offset in ipairs({
            Vector3.new(90, 0, 0), Vector3.new(0, 0, 90),
            Vector3.new(-90, 0, 0), Vector3.new(0, 0, -90),
            Vector3.new(185, 0, 0), Vector3.new(0, 0, 185),
            Vector3.new(-185, 0, 0), Vector3.new(0, 0, -185),
        }) do
            add(base + offset, "cdk-search")
        end
    end

    -- When markers aren't replicated (streaming), search around quest NPC.
    -- Rotate waypoints instead of waiting endlessly at one coordinate.
    if #candidates == 0 then
        local quest = GetQuest()
        local base = quest and quest.NameQuest and GetQuestPosition(quest.NameQuest)
        if base then
            for _, offset in ipairs({
                Vector3.new(110, 0, 0), Vector3.new(0, 0, 110),
                Vector3.new(-110, 0, 0), Vector3.new(0, 0, -110),
                Vector3.new(250, 0, 0), Vector3.new(0, 0, 250),
                Vector3.new(-250, 0, 0), Vector3.new(0, 0, -250),
            }) do
                add(base + offset, "quest-area")
            end
        end
    end
    table.sort(candidates, function(a, b)
        return LocalPlayer:DistanceFromCharacter(a.Position) < LocalPlayer:DistanceFromCharacter(b.Position)
    end)
    return candidates
end

local FarmWaypointIndex, FarmWaypointTarget, FarmWaypointUntil = 1, nil, 0
local function SelectQuestWaypoint()
    local target = NormalizeQuestMobName(GetActiveQuestMobName())
    if FarmWaypointTarget ~= target then
        FarmWaypointTarget, FarmWaypointIndex, FarmWaypointUntil = target, 1, 0
    end
    local candidates = GetQuestSpawnCandidates()
    if #candidates == 0 then return nil, 0 end
    if tick() >= FarmWaypointUntil then
        if FarmWaypointUntil ~= 0 then
            FarmWaypointIndex = FarmWaypointIndex % #candidates + 1
        end
        FarmWaypointIndex = math.clamp(FarmWaypointIndex, 1, #candidates)
        -- Long trips get time to finish; otherwise the next waypoint
        -- can be selected in mid-flight (back-and-forth movement).
        local travelDistance = LocalPlayer:DistanceFromCharacter(candidates[FarmWaypointIndex].Position)
        FarmWaypointUntil = tick() + math.clamp(travelDistance / 240 + 12, 14, 70)
    end
    FarmWaypointIndex = math.clamp(FarmWaypointIndex, 1, #candidates)
    return candidates[FarmWaypointIndex], #candidates
end

