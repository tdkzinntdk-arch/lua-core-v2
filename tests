-- Movimentos de raid NAO devem usar SmartTween/requestEntrance: esses atalhos
-- sao validos para o mundo aberto, mas podem tirar o jogador da instancia
-- da raid e provocar o teleporte para muito longe relatado pelo usuario.
local function RaidMoveTo(position, speed, threshold)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false, "no character" end
    threshold = threshold or 125
    local before = (root.Position - position).Magnitude
    if before <= threshold then return true, "already near" end
    local tween = RunTween(position, nil, speed or 350) -- sem SmartTween!
    if not tween then return false, "no tween" end
    local deadline = tick() + math.clamp(before / math.max(speed or 350, 1) + 3, 5, 40)
    while RaidController.isRaiding and tick() < deadline do
        if not root.Parent or not char.Parent then break end
        if (root.Position - position).Magnitude <= threshold then
            -- Cancela apenas a instancia criada por ESTA chamada, sem mexer
            -- em um tween novo que outra rotina possa ter iniciado.
            pcall(function() tween:Cancel() end)
            return true, "reached"
        end
        local state = tween.PlaybackState
        if state == Enum.PlaybackState.Cancelled or state == Enum.PlaybackState.Completed then break end
        task.wait(0.2)
    end
    local after = root.Parent and (root.Position - position).Magnitude or math.huge
    return after <= threshold, string.format("distance %.0f -> %.0f", before, after)
end

local function RaidIslandCenter(locations, index)
    local island = locations and locations:FindFirstChild("Island " .. tostring(index))
    if not island then return nil end
    if island:IsA("BasePart") then return island.Position end
    if island:IsA("Model") then return island:GetPivot().Position end
    return nil
end

-- O pivot da ilha pode ficar no meio/embaixo do terreno. Procura uma
-- superficie fisica acima dele antes de escolher onde aguardar a onda.
local function RaidIslandLandingPoint(islandCenter)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {workspace.Enemies}
    if LocalPlayer.Character then
        table.insert(exclude, LocalPlayer.Character)
    end
    params.FilterDescendantsInstances = exclude
    local ray = workspace:Raycast(
        islandCenter + Vector3.new(0, 260, 0),
        Vector3.new(0, -460, 0),
        params
    )
    if ray and ray.Instance and ray.Normal.Y > 0.4
        and math.abs(ray.Position.Y - islandCenter.Y) < 230 then
        return ray.Position + Vector3.new(0, 18, 0)
    end
    return islandCenter + Vector3.new(0, 85, 0)
end

local function RaidEnemyNearIsland(islandCenter)
    if not islandCenter then return nil end
    local bestEnemy, bestDist = nil, math.huge
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    for _, enemy in workspace.Enemies:GetChildren() do
        local humanoid = enemy:FindFirstChildOfClass("Humanoid")
        local part = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
        if humanoid and humanoid.Health > 0 and part
           and (part.Position - islandCenter).Magnitude < 600 then
            local playerDist = (part.Position - root.Position).Magnitude
            if playerDist < bestDist then
                bestEnemy, bestDist = enemy, playerDist
            end
        end
    end
    return bestEnemy, bestDist
end

AutoDungeon = function()
    LogChange("raid", "raid: preparing")
    if not EsperarPersonagem(30, true) then
        return
    end
    if not RaidController.isRaiding then
        if not HasItem("Special Microchip") then
            LogChange("raid_stage", "raid: getting microchip safely")
            SetStatus("raid | getting microchip")

            -- Nao arriscar uma fruta ja carregada (especialmente as raras).
            -- O auto-store continua funcionando e pode guardá-la no proximo ciclo.
            local carriedFruit = GetCarriedPhysicalFruit()
            if carriedFruit then
                LogChange("raid_fruit_guard", "raid: fruit in backpack; waiting for auto-store: " .. carriedFruit.Name)
                SetStatus("raid | storing carried fruit")
                return
            end

            -- Preferencia: pagar com Beli, sem carregar fruta alguma.
            if LocalPlayer.Data.Beli.Value >= 100000 then
                local ok, result = pcall(function()
                    return CommF_:InvokeServer("RaidsNpc", "Select", "Dark")
                end)
                if not ok then
                    warn("[Zyon] Raid: error buying chip with Beli: " .. tostring(result))
                end
                task.wait(0.5)
                -- Mantem a compatibilidade com Select que devolve 1 (confirmacao).
                if ok and not HasItem("Special Microchip") and result == 1 then
                    pcall(function() CommF_:InvokeServer("RaidsNpc", "Select", "Dark") end)
                    task.wait(0.5)
                end
            end

            -- Sem chip: usar SOMENTE fruta comprovadamente abaixo de 1M.
            if not HasItem("Special Microchip") then
                local cheapFruit = GetUseableFruit()
                if not cheapFruit then
                    LogChange("raid_fruit_guard", "raid: no eligible fruit (< 1M); preserving valuable fruits")
                    SetStatus("raid | waiting for cheap fruit or Beli")
                    return
                end

                PAUSE_AUTO_STORE = true
                local ok, err = pcall(function()
                    CommF_:InvokeServer("LoadFruit", cheapFruit)
                    task.wait(0.6)
                    -- Se LoadFruit falhou, nao selecionar NPC com fruta desconhecida.
                    local loadedFruit = GetCarriedPhysicalFruit()
                    if not loadedFruit then
                        error("cheap fruit not loaded; NPC selection cancelled")
                    end
                    CommF_:InvokeServer("RaidsNpc", "Select", "Dark")
                end)
                PAUSE_AUTO_STORE = false
                if not ok then
                    warn("[Zyon] Raid: aborting fruit purchase: " .. tostring(err))
                    return
                end
                task.wait(0.5)
            end

            if not HasItem("Special Microchip") then
                LogChange("raid_chip", "raid: no microchip yet; will retry safely")
                SetStatus("raid | waiting for microchip")
                return
            end
        end
		if World.Sea2() then
            LogChange("raid_stage", "raid: summoning at sea 2")
            SetStatus("raid | summoning at sea 2")
			local clickDetector = workspace.Map.CircleIsland.RaidSummon2:FindFirstChildWhichIsA("ClickDetector", true)
			if clickDetector then
				pcall(fireclickdetector, clickDetector)
			end
		elseif World.Sea3() then
            LogChange("raid_stage", "raid: summoning at sea 3")
            SetStatus("raid | summoning at sea 3")
			Tween(Vector3.new(-5018, 315, -2828), 300).Completed:Wait()
			task.wait(1)
			local clickDetector = workspace.Map["Boat Castle"].RaidSummon2:FindFirstChildWhichIsA("ClickDetector", true)
			if clickDetector then
				pcall(fireclickdetector, clickDetector)
			end
		end
		local startWait = tick()
        LogChange("raid_state", "raid: waiting to join")
        SetStatus("raid | waiting to join")
		repeat
			SetStatus("raid | waiting to join")
			StopTween()
			task.wait(0.25)
		until RaidController.isRaiding or (tick() - startWait) >= 30
        LogChange("raid_state", RaidController.isRaiding and "raid: started" or "raid: join timed out")
        SetStatus(RaidController.isRaiding and "raid | started" or "raid | join timed out")
		task.wait(0.5)
    end -- fim da preparacao/chamada; uma raid JA ativa vai direto para o combate
    if not RaidController.isRaiding then
        LogChange("raid_state", "raid: no active instance after summon")
        return
    end

    -- Apos retomar AutoDungeon, continua na ilha atual, sem recomecar pela 1.
    local raidIslandIndex = math.clamp(RaidController.currentIsland or 1, 1, 5)
    local lastEnemySeen = tick()
    local lastMoveAttempt = 0
    local lastMoveIndex = 0
    local consecutiveMoveFailures = 0
    while RaidController.isRaiding do
        if RaidController.startedAt > 0 and tick() - RaidController.startedAt > 16 * 60 then
            warn("[Zyon] raid: timeout de 16min sem encerramento; voltando ao ciclo")
            RaidController.isRaiding = false
            break
        end

        local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
        local locations = worldOrigin and worldOrigin:FindFirstChild("Locations")
        local islandCenter = RaidIslandCenter(locations, raidIslandIndex)
        local closestEnemy, closestDist = RaidEnemyNearIsland(islandCenter)
        if closestEnemy then
            lastEnemySeen = tick()
        elseif islandCenter and raidIslandIndex < 5
            and LocalPlayer:DistanceFromCharacter(islandCenter) <= 230
            and tick() - lastEnemySeen >= 7 then
            -- A ilha seguinte precisa EXISTIR e ser razoavelmente proxima;
            -- nao inferimos progresso so pela ausencia temporaria de mobs.
            local nextCenter = RaidIslandCenter(locations, raidIslandIndex + 1)
            if nextCenter and (nextCenter - islandCenter).Magnitude <= 4000 then
                raidIslandIndex = raidIslandIndex + 1
                RaidController.currentIsland = raidIslandIndex
                islandCenter = nextCenter
                closestEnemy, closestDist = RaidEnemyNearIsland(islandCenter)
                lastEnemySeen = tick()
                lastMoveAttempt = 0
                consecutiveMoveFailures = 0
                LogChange("raid_island", "raid: advancing to island " .. tostring(raidIslandIndex))
            end
        end

        if closestEnemy and RaidController.isRaiding then
            SetStatus("raid | defeating enemies | island " .. tostring(raidIslandIndex))
            local humanoid = closestEnemy:FindFirstChildOfClass("Humanoid")
            local root = closestEnemy:FindFirstChild("HumanoidRootPart") or closestEnemy.PrimaryPart
            -- Attack() filtra alvos a ATE 35 studs! A antiga raid so
            -- aproximava quando >62 e tentava atacar desde 75: nessa faixa
            -- o status mostrava "defeating enemies", mas nenhum golpe acertava.
            local RAID_HIT_DISTANCE = 29 -- margem para o filtro interno de 35
            local RAID_APPROACH_TOLERANCE = 10
            local killDeadline = tick() + 32
            local nextMove = 0
            local lastDamageAt = tick()
            local lastHealth = humanoid.Health
            local consecutiveApproachFailures = 0
            while RaidController.isRaiding and humanoid and humanoid.Parent
                and humanoid.Health > 0 and root and root.Parent and tick() < killDeadline do
                local dist = LocalPlayer:DistanceFromCharacter(root.Position)
                if humanoid.Health < lastHealth then
                    lastHealth = humanoid.Health
                    lastDamageAt = tick()
                    consecutiveApproachFailures = 0
                end
                if dist > RAID_HIT_DISTANCE then
                    if tick() >= nextMove then
                        -- Aproxima de VERDADE: offset de ~13 studs do inimigo,
                        -- tolerancia 10. Nunca usa SmartTween/requestEntrance.
                        local target = root.Position + Vector3.new(0, 12, 5)
                        local ok, detail = RaidMoveTo(target, 320, RAID_APPROACH_TOLERANCE)
                        local after = LocalPlayer:DistanceFromCharacter(root.Position)
                        if not ok or after > 35 then
                            consecutiveApproachFailures = consecutiveApproachFailures + 1
                            LogChange("raid_combat_travel", string.format(
                                "raid: enemy approach failed (enemy %.0f studs, %s)",
                                after, tostring(detail)))
                        else
                            consecutiveApproachFailures = 0
                            LogChange("raid_combat_arrival", string.format(
                                "raid: reached enemy (%.0f studs)", after))
                        end
                        nextMove = tick() + (consecutiveApproachFailures >= 3 and 2 or 0.3)
                    else
                        task.wait(0.1)
                    end
                else
                    -- Agora so ataca quando o alvo esta ao alcance real.
                    pcall(sethiddenproperty, LocalPlayer, "SimulationRadius", math.huge)
                    EquipWeapon()
                    local hitOk, hitErr = pcall(Attack)
                    if not hitOk then
                        LogChange("raid_attack_error", "raid: attack failed: " .. tostring(hitErr))
                    end
                    -- Se o NPC nao perder vida, reposiciona em vez de ficar
                    -- parado repetindo ataques que nao estao conectando.
                    if tick() - lastDamageAt > 7 then
                        LogChange("raid_no_damage", string.format(
                            "raid: enemy HP unchanged for 7s (distance %.0f); correcting position", dist))
                        local correction = root.Position + Vector3.new(0, 8, -4)
                        RaidMoveTo(correction, 260, 7)
                        lastDamageAt = tick()
                    end
                    task.wait(0.15)
                end
            end
            if humanoid and humanoid.Parent and humanoid.Health > 0 then
                LogChange("raid_enemy_timeout", "raid: enemy timeout; rechecking island")
            end
        elseif islandCenter and RaidController.isRaiding then
            -- O centro da ilha pode estar DENTRO do terreno: raycast para
            -- encontrar uma area mais segura acima da superficie.
            local destination = RaidIslandLandingPoint(islandCenter)
            local distance = LocalPlayer:DistanceFromCharacter(destination)
            if distance > 160 then
                if (tick() - lastMoveAttempt) >= 9 or lastMoveIndex ~= raidIslandIndex then
                    lastMoveAttempt = tick()
                    lastMoveIndex = raidIslandIndex
                    if distance > 7000 then
                        warn(string.format("[Zyon] raid: island %d destination %.0f studs away; waiting for map to load", raidIslandIndex, distance))
                        SetStatus("raid | waiting for island position")
                        task.wait(2)
                    else
                        SetStatus("raid | moving to island " .. tostring(raidIslandIndex))
                        local ok, detail = RaidMoveTo(destination, 350, 160)
                        if not ok then
                            consecutiveMoveFailures = consecutiveMoveFailures + 1
                            warn(string.format("[Zyon] raid: island %d movement failed (%s), attempt %d", raidIslandIndex, detail, consecutiveMoveFailures))
                            if consecutiveMoveFailures >= 2 then
                                SetStatus("raid | movement blocked; waiting for next wave")
                                task.wait(5)
                            end
                        else
                            consecutiveMoveFailures = 0
                            LogChange("raid_arrival", "raid: reached island " .. tostring(raidIslandIndex))
                        end
                    end
                else
                    SetStatus("raid | waiting for island movement cooldown")
                    task.wait(0.35)
                end
            else
                SetStatus("raid | waiting for next wave")
                task.wait(0.4)
            end
        else
            SetStatus("raid | waiting for island to load")
            task.wait(0.5)
        end
        task.wait(0.1)
    end
	 task.wait(5)
    LogChange("raid_state", "raid: cycle ended")
end

