        end
        local ok, err = pcall(fireclickdetector, detector)
        if not ok then
            warn("[Zyon] Yama click failed: " .. tostring(err))
            return false
        end
        task.wait(0.75)
    until tick() >= deadline or not RaidController or RaidController.isRaiding

    if HasItem("Yama") or CheckItem("Yama") then
        LogChange("yama", "yama: acquired")
        return true
    end
    warn("[Zyon] Yama: no sword after interaction; will retry after cooldown")
    return false
end

