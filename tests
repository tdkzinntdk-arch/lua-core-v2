        NextYamaAttempt = tick() + 600
        warn("[Zyon] Yama: sword/click detector unavailable; farming for 10min before retry")
        return false
    end

    -- O script antigo clicava de qualquer lugar sem se aproximar da espada.
    if LocalPlayer:DistanceFromCharacter(hitbox.Position) > 18 then
        local reached = TweenWithRespawnRetry(hitbox.Position + Vector3.new(0, 4, 0), 350)
