local function MeleeKaitunLogic()
    LogChange("melee_logic", "melee: checking styles")
	if Character then
		local beli = LocalPlayer.Data.Beli.Value
		if not CollectionService:HasTag(Character, "Buso") and (beli >= 25000) then
			CommF_:InvokeServer("BuyHaki", "Buso")
		end
		if not CollectionService:HasTag(Character, "Geppo") and (beli >= 10000) then
			CommF_:InvokeServer("BuyHaki", "Geppo")
		end
		if not CollectionService:HasTag(Character, "Soru") and (beli >= 100000) then
			CommF_:InvokeServer("BuyHaki", "Soru")
		end
	else
		return
	end
    -- Atualiza posse/maestria periodicamente, inclusive depois de compras.
    CheckMeleeMastery()
	for _, v in {"BlackLeg", "Electro", "FishmanKarate"} do
		-- Electric deve ser comprado no Sea 1; no Sea 2/3 nao bloqueie o farm tentando compra-lo.
		if v == "Electro" and not World.Sea1() then
			continue
		end
		local realName = GetMeleeToolName(v)

			if (MeleeData[v] or 0) < 400 then
            LogChange("melee_progress", "melee: " .. string.lower(realName) .. " " .. tostring(MeleeData[v] or 0) .. "/400")

			if (MeleeData[v] or 0) == 0 and LocalPlayer.Data.Beli.Value < MeleePrices[v].Price.Beli then
                LogChange("melee_wait", "melee: need beli for " .. string.lower(realName))

				return
			end
			if not HasItem(realName) then
                LogChange("melee_action", "melee: getting " .. string.lower(realName))
				if not TweenToMeleeBuyer(v) then
					SetStatus("melee | buyer position unavailable: " .. realName)
					return true
				end
				-- Enquanto o fluxo viaja/compra o estilo, nao deixe FarmLevelLogic
				-- tomar o controle do movimento no mesmo ciclo e mandar o player
				-- de volta para a quest (ex.: Cursed Ship -> NPC -> Cursed Ship).
				task.wait(0.5)
				local ok, result = pcall(function()
					return CommF_:InvokeServer("Buy" .. v)
				end)
				if not ok then
					LogChange("melee_buy_error", "melee: buy request failed for " .. realName)
				else
					LogChange("melee_buy_result", "melee: buy request sent for " .. realName)
				end
				return true
			end
			-- Se o estilo ja esta no inventario, deixe a rotina de farm normal
			-- continuar; nao volte ao NPC em cada iteracao.
			return
		end
	end

	if not World.Sea1() then
		for _, v in {"DragonClaw", "Superhuman", "DeathStep", "SharkmanKarate"} do
			local realName = GetMeleeToolName(v)
            if v == "DragonClaw" then
                -- Dragon Breath: EVITAR COBRAR 1.500 FRAGMENTOS REPETIDAMENTE.
                -- Ter maestria zero e nao ter a Tool equipada NAO significa
                -- que o Sabi ainda nao vendeu o estilo.
                if (MeleeData.DragonClaw or 0) < 400 then
                    if OwnsMeleeStyle("DragonClaw") then
                        LogChange("dragon_breath", "melee: dragon breath already owned; no repurchase")
                        -- O farm normal continua. Nunca chamar BlackbeardReward
                        -- para "reequipar" a cada ciclo.
                        return
                    end
                    if not CheckedMelee then
                        LogChange("dragon_breath", "melee: dragon breath ownership not verified; keeping fragments")
                        return
                    end
                    if LocalPlayer.Data.Fragments.Value < 1500 then
                        if CheckCanDungeon() and LocalPlayer.Data.Level.Value >= 1250 then
                            AutoDungeon()
                            return true
                        end
                        return
                    end
                    if MeleePurchaseGuard.DragonClaw then
                        LogChange("dragon_breath", "melee: dragon breath purchase already attempted; preserving fragments")
                        return
                    end
                    if not TweenToMeleeBuyer("DragonClaw") then
                        LogChange("dragon_breath", "melee: sabi unreachable; not buying")
                        return true
                    end
                    -- Ultima confirmacao de posse antes de qualquer compra.
                    if not CheckMeleeMastery(true) or OwnsMeleeStyle("DragonClaw") then return end
                    MeleePurchaseGuard.DragonClaw = true
                    local fragmentsBefore = LocalPlayer.Data.Fragments.Value
                    local ok, result = pcall(function()
                        return CommF_:InvokeServer("BlackbeardReward", "DragonClaw", "2")
                    end)
                    task.wait(1)
                    CheckMeleeMastery(true)
                    LogChange("dragon_breath_buy", string.format(
                        "melee: dragon breath attempted once; ok=%s result=%s fragments=%d->%d owned=%s",
                        tostring(ok), tostring(result), fragmentsBefore,
                        LocalPlayer.Data.Fragments.Value, tostring(OwnsMeleeStyle("DragonClaw"))))
                    return true
                end
                continue
            end
			if (MeleeData[v] or 0) < 400 then
				local hasEnoughEco = (
					(MeleePrices[v].Price.Beli == nil) or (LocalPlayer.Data.Beli.Value >= MeleePrices[v].Price.Beli)
				)
					and (
						(MeleePrices[v].Price.Fragments == nil)
						or (LocalPlayer.Data.Fragments.Value >= MeleePrices[v].Price.Fragments)
					)
				if (MeleeData[v] or 0) == 0 and hasEnoughEco then
                    LogChange("melee_action", "melee: unlocking " .. string.lower(realName))
					if v ~= "DragonClaw" and v ~= "Superhuman" then
						GetMeleeLogics[v]()
						return true
					else
						TweenToMeleeBuyer(v)
						if v == "Superhuman" then
							CommF_:InvokeServer("Buy" .. v)
