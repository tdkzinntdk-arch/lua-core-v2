local tw, conn

-- CORRIGIDO (Zyon): POSSE DE TWEEN.
--
-- Antes, `tw` era uma unica variavel de modulo compartilhada por TODAS as
-- corrotinas. Qualquer rotina que chamasse Tween/RunTween sobrescrevia `tw`:
--
--   L431  tw = TweenService:Create(...)   <- rotina A
--   L505  tw = RunTween(...)              <- rotina B sobrescreve
--   L507  tw.Completed:Wait()             <- rotina A espera o tween de B
--   L372  tw:Cancel()                     <- cancela o tween de OUTRA rotina
--
-- Consequencia observada como "anda e volta" e travamento: a rotina A fica
-- presa em `while not finished` (L588) porque o `.Completed` do tween que
-- ela iniciou nunca chega — foi substituido antes.
--
-- Correcao: cada tween recebe um ID de dono (geracao). Uma rotina so pode
-- cancelar/esperar o tween que ela mesma iniciou. Nao altera a assinatura
-- de nenhuma funcao publica.
local TwGen = 0          -- contador global de geracao
local TwDono = nil       -- dono do tween ativo em `tw`

local function TwNovaGeracao()
	TwGen = TwGen + 1
	return TwGen
end

local function TwAtivo(gen)
	-- o tween em `tw` ainda pertence a esta rotina?
	return tw ~= nil and TwDono == gen
end

local function StopTween(gen)
	-- Sem argumento: comporta-se como antes (cancela o que estiver ativo).
	-- Com argumento: so cancela se o tween pertencer a essa geracao.
	if gen ~= nil and TwDono ~= gen then
		return -- o tween ativo e de outra rotina; nao mexemos nele
	end
	if tw then
        LogChange("tween_stop", "tween: stopped")
		tw:Cancel()
		tw = nil
		TwDono = nil
	end
	if conn then
		conn:Disconnect()
		conn = nil
	end
	local r = Character and Character:FindFirstChild("Root")
	if r then
		r:Destroy()
	end
end

