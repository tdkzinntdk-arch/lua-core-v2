    local deadline = tick() + 18
    repeat
        if HasItem("Yama") or CheckItem("Yama") then
            LogChange("yama", "yama: acquired")
            return true
        end
        if LocalPlayer:DistanceFromCharacter(hitbox.Position) > 25 then
            warn("[Zyon] Yama: character moved away; retrying later")
