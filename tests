local function WaitForAliveCharacter(timeout)
    timeout = math.max(1, tonumber(timeout) or 20)
    local deadline = tick() + timeout
    repeat
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if character and character.Parent and humanoid and humanoid.Health > 0 and root then
            return character, humanoid, root
        end
        task.wait(0.1)
    until tick() >= deadline
    warn(("[Zyon] character did not become alive within %ds"):format(timeout))
    return nil, nil, nil
end

local function TweenWithRespawnRetry(target, speed, high)
    local maxAttempts = 3
    local attempt = 0
    while attempt < maxAttempts do
        attempt = attempt + 1
        local currentCharacter = LocalPlayer.Character
        local currentHumanoid = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
        local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
        if not currentCharacter or not currentHumanoid or currentHumanoid.Health <= 0 or not currentRoot then
            LogChange("respawn_wait", "tween: waiting for respawn")
        end
        local startCharacter, humanoid, root = WaitForAliveCharacter(20)
        if not startCharacter or not humanoid or not root then
            LogChange("respawn_wait", "tween: character wait timed out")
            return false
        end
        LogChange("respawn_wait", "tween: character ready")
        local died = false
        local activeTween = nil

        local diedConnection = humanoid.Died:Connect(function()
            died = true
            if activeTween then
                pcall(function()
                    activeTween:Cancel()
                end)
            end
        end)

        local ok, tweenOrError = pcall(function()
            return Tween(target, speed, high)
        end)

        if ok and tweenOrError then
            activeTween = tweenOrError

            local finished = false
            local playbackState = nil
            local completedConnection = activeTween.Completed:Connect(function(state)
                playbackState = state
                finished = true
            end)

            local currentState = activeTween.PlaybackState
            if currentState == Enum.PlaybackState.Completed or currentState == Enum.PlaybackState.Cancelled then
                playbackState = currentState
                finished = true
            end

            if died then
                pcall(function()
                    activeTween:Cancel()
                end)
            end

            local targetPosition
            if typeof(target) == "CFrame" then
                targetPosition = target.Position
            elseif typeof(target) == "Vector3" then
                targetPosition = target
            elseif typeof(target) == "Instance" and target:IsA("BasePart") then
                targetPosition = target.Position
            elseif typeof(target) == "Instance" and target:IsA("Model") then
                targetPosition = target:GetPivot().Position
            end
            local distance = targetPosition and (root.Position - targetPosition).Magnitude or 0
            local completionDeadline = tick() + math.clamp((distance / math.max(tonumber(speed) or 200, 25)) + 20, 20, 600)
            while not finished and tick() < completionDeadline do
                task.wait(0.05)
            end
            if not finished then
                pcall(function() activeTween:Cancel() end)
                completedConnection:Disconnect()
                diedConnection:Disconnect()
                warn("[Zyon] tween completion timed out; cancelled")
                return false
            end

            completedConnection:Disconnect()
            diedConnection:Disconnect()

            local currentCharacter = LocalPlayer.Character
            local stillSameCharacter = currentCharacter == startCharacter
                and humanoid.Parent ~= nil
                and humanoid.Health > 0
                and root.Parent ~= nil
                and not died

            if not stillSameCharacter then
                print("tween: retry after respawn")
                task.wait(0.1)
            elseif playbackState == Enum.PlaybackState.Completed then
                LogChange("tween_result", "tween: complete")
                return true
            else
                LogChange("tween_result", "tween: cancelled")
                return false
            end
        else
            diedConnection:Disconnect()
            local characterChanged = LocalPlayer.Character ~= startCharacter
            if died or characterChanged or humanoid.Health <= 0 or not root.Parent then
                task.wait(0.1)
            else
                if not ok then
                    warn("tween retry failed: " .. tostring(tweenOrError))
                end
                return false
            end
        end
    end
    return false
end

