local function CheckHakiLegendInTitles(NAME_HAKI)
	-- CORRIGIDO (Zyon): o corpo do pcall NAO tinha `return`.
	--
	--     local res, kl = pcall(function()
	--         CommF_:InvokeServer("getTitles")   -- resultado descartado
	--     end)
	--
	-- Ausencia de `return` faz o pcall devolver apenas `true` (sucesso) e
	-- nil como segundo valor. Como a linha seguinte testa
	-- `not kl` e devolve false, a funcao retornava SEMPRE false —
	-- independentemente do que o jogador realmente possuia.
	--
	-- Consequencia: quem dependia dela (requisito de Haki Legend para o
	-- Godhuman) nunca reconhecia o requisito como cumprido e tentava
	-- obtê-lo de novo indefinidamente.
	local res, kl = pcall(function()
		return CommF_:InvokeServer("getTitles")
	end)

	if not res or typeof(kl) ~= "table" then
		return false
	end

	local gg = kl[NAME_HAKI]

	if not gg then
		return false
	end

	-- `for _, v in kl` sem pairs() depende de __iter; se kl nao tiver
	-- metatable com __iter isso estoura. Usamos pairs() explicito.
	for _, v in pairs(kl) do
		if typeof(v) == "table" and v.Unlocked and v.Description and v.Description:find(gg) then
			return true
		end
	end

	return false
end

local function GetTitle(title)
	local a = CommF_:InvokeServer("getTitles") or {}
	for _, v in a do
		if v.InternalName == title and v.Name ~= "(LOCKED)" then
			return true
		end
	end
	return false
end

