-- AUTO REJOIN (Zyon): reentrada nao depende de __ServerBrowser:InvokeServer,
-- que pode falhar justamente quando a conexao com o servidor foi perdida.
-- Mantem uma unica sequencia de tentativas, com pcall + intervalo e logs.
-- Limite: se o processo Roblox for encerrado, um LocalScript nao pode reabri-lo.
-- Apos o teleport, o executor precisa executar o Kaitun novamente (Auto Execute).
local AutoRejoinActive = false
local AutoRejoinReason = nil
local AutoRejoinLastError = nil
local AutoRejoinMaxAttempts = math.clamp(tonumber(Config.AutoRejoinMaxAttempts) or 12, 1, 30)

local function StartAutoRejoin(reason)
    if Config.AutoRejoin == false then return end
    if AutoRejoinActive then
        return -- evita multiplos loops competindo entre si
    end
    AutoRejoinActive = true
    AutoRejoinReason = tostring(reason or "unknown")

    task.spawn(function()
        print("[Zyon] rejoin: detected " .. AutoRejoinReason)
        for attempt = 1, AutoRejoinMaxAttempts do
            -- Espaco inicial para permitir que a interface de erro estabilize;
            -- apos isso, evita chamar o servico de teleporte a cada frame.
            local delaySeconds = (attempt == 1) and 2 or math.min(12 + (attempt - 2) * 8, 60)
            task.wait(delaySeconds)
            print(("[Zyon] rejoin: attempt %d/%d (place %s)"):format(
                attempt, AutoRejoinMaxAttempts, tostring(game.PlaceId)))
            local ok, err = pcall(function()
                -- Teleport(placeId, player) funciona a partir do cliente.
                -- Nao solicita teleporte para game.JobId (servidor que caiu).
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
            if not ok then
                AutoRejoinLastError = tostring(err)
                warn("[Zyon] rejoin: teleport rejected: " .. AutoRejoinLastError)
            else
                -- A chamada retornar nao garante que o teleport ocorreu.
                -- O TeleportInitFailed, abaixo, informa quando ele falhou.
                print("[Zyon] rejoin: teleport requested; awaiting connection")
            end
        end
        warn("[Zyon] rejoin: retries exhausted; last error: " ..
            tostring(AutoRejoinLastError or "not confirmed"))
        AutoRejoinActive = false
    end)
end

