local function BringSG(v)
	if not EsperarPersonagem(30, true) then
		return
	end
	local targets = {}
	-- CORRIGIDO (Zyon): a condicao usava `p.Position` mas `p` NUNCA foi
	-- declarado nesta funcao (nem em nenhum escopo visivel). Em Lua isso
	-- resolve para a global implicita `p`, que e nil -> erro em runtime:
	--     attempt to index nil with 'Position'
	-- `BringSG` e chamada no fluxo do Skull Guitar, entao a rotina quebrava.
	--
	-- Alem disso o filtro era `...Magnitude <= math.huge`, que e SEMPRE
	-- verdadeiro — o `p` nao filtrava nada, so podia estourar. Como o
	-- proposito real e "trazer inimigos para perto", removemos a condicao
	-- impossivel e mantemos os testes que de fato importam.
	local _origem = Character and Character.PrimaryPart and Character.PrimaryPart.Position

	for _, x in workspace.Enemies:GetChildren() do
		if x:FindFirstChild("HumanoidRootPart") and x:FindFirstChild("Humanoid") and x.Humanoid.Health > 0 and (not v or x.Name == v) then
			-- sem limite artificial de distancia: o comportamento original
			-- era `<= math.huge` (aceitar tudo). Mantido identico.
			if not _origem or (x.HumanoidRootPart.Position - _origem).Magnitude <= math.huge then
				targets[#targets + 1] = x
			end
			if #targets == 6 then
				break
			end
		end
	end
	if #targets == 0 then
		return
	end
	local t = targets[1].HumanoidRootPart.CFrame
	for _, x in targets do
		sethiddenproperty(x.HumanoidRootPart, "NetworkOwnershipRule", Enum.NetworkOwnership.Manual)
		x.HumanoidRootPart.CFrame = t
	end
end

